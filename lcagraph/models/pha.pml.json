        "chemical_generic":{ "label": "Chemical (generic)",     "flow": 0.000526, "flow_unit": "kg",   "cf": 2.059101141,   "cf_unit": "per kg",   "reagent": 1 },
        "cacl2":           { "label": "Calcium chloride",       "flow": 0.0005,   "flow_unit": "kg",   "cf": 0.82054810,    "cf_unit": "per kg",   "reagent": 1 },
        "water":           { "label": "Water",                  "flow": 0.11,     "flow_unit": "kg",   "cf": 0.0004875577,  "cf_unit": "per kg",   "reagent": 1 }
      }
    }
  },
  "units": {
    "env": { "kind": "env" },
    "biomass_handling":   { "label": "Biomass handling",     "sub": "receiving, wet storage", "kind": "separator", "params": ["basis_tpa", "moisture"] },
    "pretreatment":       { "label": "Biomass pretreatment", "sub": "fractionation",          "kind": "separator", "params": ["hemi_pct", "cell_pct", "lign_pct", "ash_pct", "rec_hemi", "rec_cell", "rec_lign"] },
    "inoculation":        { "label": "Inoculation",          "sub": "seed train",             "kind": "reactor" },
    "fermenters":         { "label": "Fermenters",           "sub": "PHA accumulation",       "kind": "reactor",    "params": ["rec_pha"] },
    "centrifugation":     { "label": "Centrifugation",       "sub": "cell harvest",           "kind": "separator" },
    "solvent_extraction": { "label": "Solvent extraction",   "sub": "PHA recovery",           "kind": "separator" },
    "washing":            { "label": "Washing",              "kind": "separator" },
    "drying":             { "label": "Drying",               "kind": "separator" },
    "anaerobic_digestion":{ "label": "Anaerobic digestion",  "sub": "residue + wastewater",   "kind": "reactor" },
    "chp":                { "label": "CHP",                  "sub": "combined heat and power","kind": "converter",  "params": ["calorific", "elec_eff"] },
    "utilities":          { "label": "Plant electricity",    "sub": "demand vs generation",   "kind": "mixer",      "params": ["elec_consump"] },
    "extrusion":          { "label": "Twin-screw extrusion", "sub": "compounding",            "kind": "mixer",      "params": ["biocomp_rec"] },
    "injection_moulding": { "label": "Injection moulding",   "kind": "converter" },
    "printing_3d":        { "label": "3D printing",          "kind": "converter" }
  },
  "streams": {
    "wet_biomass": {
      "label": "Wet biomass", "from": "env", "to": "biomass_handling",
      "dim": "mass_year", "unit": "t/y", "expr": "basis_tpa / (1 - moisture)",
      "basis": "Dry basis divided by the dry fraction"
    },
    "dry_biomass": {
      "label": "Dry biomass", "from": "biomass_handling", "to": "pretreatment",
      "dim": "mass_year", "unit": "t/y",
      "components": {
        "hemicellulose": "basis_tpa * hemi_pct",
        "cellulose": "basis_tpa * cell_pct",
        "lignin": "basis_tpa * lign_pct",
        "ash": "basis_tpa * ash_pct"
      }
    },
    "process_water": {
      "label": "Feedstock moisture to digester", "from": "biomass_handling", "to": "anaerobic_digestion",
      "dim": "mass_year", "unit": "t/y", "expr": "wet_biomass * moisture",
      "basis": "The dashboard sizes the digester on the feedstock moisture plus the CHP feedstock"
    },
    "ferm_feed": {
      "label": "Fermenter feed (recovered)", "from": "pretreatment", "to": "inoculation",
      "dim": "mass_year", "unit": "t/y",
      "components": {
        "hemicellulose": "dry_biomass.hemicellulose * rec_hemi",
        "cellulose": "dry_biomass.cellulose * rec_cell",
        "lignin": "dry_biomass.lignin * rec_lign"
      }
    },
    "biofiller": {
      "label": "Biofiller (unrecovered cellulose)", "from": "pretreatment", "to": "extrusion",
      "dim": "mass_year", "unit": "t/y", "product": "co",
      "components": { "cellulose": "dry_biomass.cellulose - ferm_feed.cellulose" },
      "notes": ["q_biofiller"]
    },
    "pretreat_reject": {
      "label": "Pretreatment reject", "from": "pretreatment", "to": "env",
      "dim": "mass_year", "unit": "t/y", "closes": true,
      "components": {
        "hemicellulose": "dry_biomass.hemicellulose - ferm_feed.hemicellulose",
        "lignin": "dry_biomass.lignin - ferm_feed.lignin",
        "ash": "dry_biomass.ash"
      }
    },
    "inoculated_feed": {
      "label": "Inoculated feed", "from": "inoculation", "to": "fermenters",
      "dim": "mass_year", "unit": "t/y", "expr": "ferm_feed",
      "basis": "Carried through unchanged", "notes": ["i_carry_through"]
    },
    "broth": {
      "label": "Fermentation broth", "from": "fermenters", "to": "centrifugation",
      "dim": "mass_year", "unit": "t/y", "expr": "inoculated_feed",
      "basis": "Carried through unchanged", "notes": ["i_carry_through"]
    },
    "pha_crude": {
      "label": "PHA copolymers (cell mass)", "from": "centrifugation", "to": "solvent_extraction",
      "dim": "mass_year", "unit": "t/y",
      "expr": "(ferm_feed.hemicellulose + ferm_feed.cellulose) * rec_pha",
      "basis": "PHA yield on the recovered hemicellulose + cellulose"
    },
    "chp_feed": {
      "label": "CHP feedstock (fermentation residue)", "from": "centrifugation", "to": "anaerobic_digestion",
      "dim": "mass_year", "unit": "t/y", "closes": true,
      "expr": "dry_biomass.lignin + ferm_feed.hemicellulose + ferm_feed.cellulose - biofiller - pha_crude",
      "basis": "Dashboard I12 = E7 + F5 + F6 − G6 − H10", "notes": ["q_chp_feed"]
    },
    "pha_extract": {
      "label": "PHA extract", "from": "solvent_extraction", "to": "washing",
      "dim": "mass_year", "unit": "t/y", "expr": "pha_crude",
      "basis": "Carried through unchanged", "notes": ["i_carry_through"]
    },
    "pha_washed": {
      "label": "Washed PHA", "from": "washing", "to": "drying",
      "dim": "mass_year", "unit": "t/y", "expr": "pha_extract",
      "basis": "Carried through unchanged", "notes": ["i_carry_through"]
    },
    "pha": {
      "label": "PHA copolymers (dry)", "from": "drying", "to": "extrusion",
      "dim": "mass_year", "unit": "t/y", "expr": "pha_washed"
    },
    "biogas": {
      "label": "Digester output to CHP", "from": "anaerobic_digestion", "to": "chp",
      "dim": "mass_year", "unit": "t/y", "expr": "chp_feed",
      "basis": "The dashboard converts the whole CHP feedstock at its calorific value"
    },
    "ad_effluent": {
      "label": "Digester effluent", "from": "anaerobic_digestion", "to": "env",
      "dim": "mass_year", "unit": "t/y", "expr": "process_water", "closes": true
    },
    "chp_exhaust": {
      "label": "CHP exhaust and ash", "from": "chp", "to": "env",
      "dim": "mass_year", "unit": "t/y", "expr": "biogas", "closes": true
    },
    "elec_gen": {
      "label": "Electricity generated", "from": "chp", "to": "utilities",
      "dim": "energy_year", "unit": "GJ/y", "recycle": true,
      "expr": "biogas / 1000 * calorific * elec_eff",
      "basis": "Feedstock tonnes × calorific value × electrical efficiency"
    },
    "elec_import": {
      "label": "Net electricity import", "from": "env", "to": "utilities", "stage": "lci",
      "dim": "energy_year", "unit": "TJ/y", "closes": true,
      "expr": "elec_demand - elec_gen",
      "basis": "Negative when the CHP exports", "notes": ["i_elec_export"]
    },
    "compound": {
      "label": "Compounded biocomposite", "from": "extrusion", "to": "injection_moulding",
      "dim": "mass_year", "unit": "t/y", "expr": "precursor * biocomp_rec"
    },
    "compound_loss": {
      "label": "Compounding loss", "from": "extrusion", "to": "env",
      "dim": "mass_year", "unit": "t/y", "expr": "precursor - compound", "closes": true
    },
    "moulded": {
      "label": "Moulded biocomposite", "from": "injection_moulding", "to": "printing_3d",
      "dim": "mass_year", "unit": "t/y", "expr": "compound",
      "basis": "Carried through unchanged"
    },
    "biocomposite": {
      "label": "PHA biocomposite", "from": "printing_3d", "to": "env",
      "dim": "mass_year", "unit": "t/y", "expr": "moulded", "product": "main"
    }
  },
  "derived": {
    "comp_sum": {
      "label": "Composition sum", "stage": "mass", "dim": "fraction", "unit": "%", "role": "check",
      "expr": "hemi_pct + cell_pct + lign_pct + ash_pct"
    },
    "dry_organics": {
      "label": "Dry biomass total (hemicellulose + cellulose + lignin)", "stage": "mass", "dim": "mass_year", "unit": "t/y",
      "expr": "dry_biomass.hemicellulose + dry_biomass.cellulose + dry_biomass.lignin",
      "basis": "Dashboard Totals row, which omits ash"
    },
    "precursor": {
      "label": "Biocomposite precursor (PHA + biofiller)", "stage": "mass", "dim": "mass_year", "unit": "t/y",
      "expr": "pha + biofiller"
    },

    "reag_sum": {
      "label": "Reagent inventory per kg biocomposite", "stage": "lci", "dim": "mass_intensity", "unit": "kg/kg", "role": "lci",
      "expr": "sum(col(lci, flow) * col(lci, reagent))",
      "basis": "Inventory rows flagged as reagents"
    },
    "reagent_demand": {
      "label": "Reagent demand", "stage": "lci", "dim": "mass_year", "unit": "t/y", "role": "lci",
      "expr": "reag_sum * precursor",
      "basis": "Scaled on PHA + biofiller, not on the finished biocomposite"
    },
    "steam_demand": {
      "label": "Process steam demand", "stage": "lci", "dim": "energy_year", "unit": "TJ/y", "role": "energy",
      "expr": "lci.steam.flow * biocomposite / 1000",
      "basis": "MJ per kg of biocomposite × biocomposite output"
    },
    "elec_demand": {
      "label": "Plant electricity demand", "stage": "lci", "dim": "energy_year", "unit": "TJ/y", "role": "energy",
      "expr": "elec_consump * precursor / 1000",
      "basis": "Scaled on PHA + biofiller"
    },

    "lci_gwp": {
      "label": "GWP contribution", "stage": "lcia", "dim": "gwp_intensity", "unit": "kg CO2e/kg", "role": "impact", "group": "gwp",
      "table": "lci", "column": "gwp", "expr": "row.flow * row.cf"
    },
    "gwp_total": {
      "label": "GWP per kg biocomposite", "stage": "lcia", "dim": "gwp_intensity", "unit": "kg CO2e/kg", "role": "impact", "group": "gwp", "kpi": true,
      "expr": "sum(col(lci, gwp))"
    },
    "gwp_annual": {
      "label": "Annual plant GWP burden", "stage": "lcia", "dim": "gwp_year", "unit": "kt CO2e/y", "role": "impact", "group": "gwp",
      "expr": "gwp_total * biocomposite / 1e6",
      "basis": "Shown by the dashboard as 't CO₂e / y' but computed in kt", "notes": ["q_gwp_ann_unit"]
    },

    "size_ferm": {
      "label": "Fermentation train size basis (fermenter feed + ash)", "stage": "capex", "dim": "mass_hour", "unit": "t/h",
      "expr": "(ferm_feed + dry_biomass.ash) / op_days / 24",
      "basis": "Dashboard G4: recovered feed plus ash, per operating hour"
    },
    "size_ad": {
      "label": "Digester size basis (moisture + residue)", "stage": "capex", "dim": "mass_hour", "unit": "t/h",
      "expr": "(process_water + chp_feed) / op_days / 24",
      "basis": "Dashboard G10"
    },
    "size_handling": {
      "label": "Handling size basis (wet biomass)", "stage": "capex", "dim": "mass_hour", "unit": "t/h",
      "expr": "wet_biomass / op_days / 24",
      "basis": "Dashboard G12"
    },
    "size_pretreat": {
      "label": "Pretreatment size basis (dry biomass incl. ash)", "stage": "capex", "dim": "mass_hour", "unit": "t/h",
      "expr": "(dry_organics + dry_biomass.ash) / op_days / 24",
      "basis": "Dashboard G13"
    },
    "size_forming": {
      "label": "Forming size basis (biocomposite precursor)", "stage": "capex", "dim": "mass_hour", "unit": "t/h",
      "expr": "precursor / op_days / 24",
      "basis": "Dashboard G14: PHA + biofiller before compounding losses"
    },
    "size_drivers": {
      "label": "Size drivers in table units [tph, tph, GWh, tph, tph, tph]", "stage": "capex", "dim": "count", "role": "series",
      "expr": "concat(size_ferm / 1000, size_ad / 1000, elec_gen / 3600, size_handling / 1000, size_pretreat / 1000, size_forming / 1000)",
      "basis": "Positional list the dashboard indexes equipment rows into"
    },
    "equipment_size": {
      "label": "Current size", "stage": "capex", "dim": "count",
      "table": "equipment", "column": "size", "expr": "at(size_drivers, row.driver)"
    },
    "equipment_cost": {
      "label": "Cost", "stage": "capex", "dim": "currency", "unit": "$M", "role": "capex",
      "table": "equipment", "column": "cost",
      "expr": "six_tenths(row.base_cost, abs(row.size), row.base_size, row.n, row.cepci_base, cepci)"
    },
    "dce": {
      "label": "Delivered cost of equipment", "stage": "capex", "dim": "currency", "unit": "$M", "role": "capex",
      "expr": "sum(col(equipment, cost))"
    },
    "tci": {
      "label": "Total capital investment", "stage": "capex", "dim": "currency", "unit": "$M", "role": "capex", "kpi": true,
      "expr": "tci_ratio * dce", "basis": "DCE × TCI/DCE ratio"
    },

    "reagent_cost": {
      "label": "Reagents", "stage": "opex", "dim": "currency_year", "unit": "$M/y", "role": "opex", "group": "variable",
      "expr": "reagent_demand / 1000 * reagent_p / 1e6"
    },
    "elec_cost": {
      "label": "Electricity (net)", "stage": "opex", "dim": "currency_year", "unit": "$M/y", "role": "opex", "group": "variable",
      "expr": "elec_import * elec_p / 1e6", "basis": "Negative = export credit"
    },
    "heat_cost": {
      "label": "Heat / steam", "stage": "opex", "dim": "currency_year", "unit": "$M/y", "role": "opex", "group": "variable",
      "expr": "steam_demand * heat_p / 1e6"
    },
    "feed_cost": {
      "label": "Feedstock", "stage": "opex", "dim": "currency_year", "unit": "$M/y", "role": "opex", "group": "variable",
      "expr": "basis_tpa / 1000 * biomass_p / 1e6"
    },
    "revenue": {
      "label": "Product revenue", "stage": "opex", "dim": "currency_year", "unit": "$M/y", "role": "revenue", "kpi": true,
      "expr": "biocomposite / 1000 * biocomp_p / 1e6"
    },
    "cap_charge": {
      "label": "Capital charge", "stage": "opex", "dim": "currency_year", "unit": "$M/y", "role": "opex", "group": "fixed",
      "expr": "tci * ann_cc", "basis": "TCI × annual capital charge"
    },
    "indirect_opex": {
      "label": "Indirect fixed opex", "stage": "opex", "dim": "currency_year", "unit": "$M/y", "role": "opex", "group": "fixed",
      "expr": "cap_charge * ind_factor", "basis": "Fraction of the capital charge"
    },
    "labour_cost": {
      "label": "Labour", "stage": "opex", "dim": "currency_year", "unit": "$M/y", "role": "opex", "group": "fixed",
      "expr": "jobs_per_kt * biocomposite / 1e6 * labor_cost / 1e6 * labor_oh",
      "basis": "Jobs per kt × kt product × cost per job × overhead"
    },
    "variable_opex": {
      "label": "Variable opex (reagents + electricity + heat)", "stage": "opex", "dim": "currency_year", "unit": "$M/y", "role": "opex", "group": "variable",
      "expr": "reagent_cost + elec_cost + heat_cost"
    },
    "misc_opex": {
      "label": "Miscellaneous opex", "stage": "opex", "dim": "currency_year", "unit": "$M/y", "role": "opex", "group": "fixed",
      "expr": "misc_frac * (indirect_opex + labour_cost + reagent_cost + heat_cost)",
      "basis": "30% of indirect + labour + reagents + heat (electricity excluded)"
    },
    "opex_total": {
      "label": "Operating cost excluding capital charge", "stage": "opex", "dim": "currency_year", "unit": "$M/y", "role": "opex",
      "expr": "indirect_opex + labour_cost + variable_opex + feed_cost + misc_opex"
    },
    "total_cost": {
      "label": "Total annual cost", "stage": "opex", "dim": "currency_year", "unit": "$M/y", "role": "opex", "kpi": true,
      "expr": "cap_charge + opex_total"
    },
    "net_profit": {
      "label": "Net annual profit", "stage": "opex", "dim": "currency_year", "unit": "$M/y", "role": "metric", "kpi": true,
      "expr": "revenue - total_cost"
    },

    "dcf_cf": {
      "label": "Discounted cash flow by year (year 0 = −TCI)", "stage": "dcf", "dim": "currency", "unit": "$M", "role": "series",
      "expr": "concat(-tci, discounted(repeat(net_profit, project_years), irr))"
    },
    "dcf_cum": {
      "label": "Cumulative NPV by year", "stage": "dcf", "dim": "currency", "unit": "$M", "role": "series",
      "expr": "cumsum(dcf_cf)"
    },
    "npv": {
      "label": "NPV over project life", "stage": "dcf", "dim": "currency", "unit": "$M", "role": "metric", "kpi": true,
      "expr": "-tci + npv(repeat(net_profit, project_years), irr)"
    },
    "payback": {
      "label": "Discounted payback", "stage": "dcf", "dim": "years", "unit": "y", "role": "metric",
      "expr": "payback(dcf_cf)"
    },
    "project_irr": {
      "label": "Project IRR", "stage": "dcf", "dim": "fraction", "unit": "%", "role": "metric",
      "expr": "irr(concat(-tci, repeat(net_profit, project_years)))"
    },
    "msp": {
      "label": "Minimum selling price (NPV = 0)", "stage": "dcf", "dim": "price_mass", "unit": "$/kg", "role": "metric",
      "solve": { "target": "npv", "vary": "biocomp_p", "lo": 0, "hi": 1000000, "equals": 0 }
    }
  },
  "checks": {
    "plant_closure": {
      "kind": "closure", "stage": "mass", "label": "Plant mass closure", "unit": "t/y",
      "in": ["wet_biomass"],
      "out": ["pretreat_reject", "biocomposite", "compound_loss", "ad_effluent", "chp_exhaust"],
      "tolerance": 0.01
    },
    "ferm_train": {
      "kind": "closure", "stage": "mass", "label": "Fermentation train closure", "unit": "t/y",
      "in": ["ferm_feed"],
      "out": ["pha_crude", "chp_feed"],
      "tolerance": 0.01
    },
    "comp_sum_check": {
      "kind": "constraint", "stage": "mass", "severity": "soft",
      "expr": "abs(comp_sum - 1) <= comp_tol",
      "message": "Dry composition must sum to 100%."
    },
    "positive_feed": {
      "kind": "constraint", "stage": "mass", "severity": "hard",
      "expr": "basis_tpa > 0 && moisture < 1",
      "message": "Dry biomass must be positive and moisture below 100%."
    }
  },
  "lcia": {
    "method": "GWP100 characterisation factors as tabulated in the dashboard",
    "categories": [
      {
        "id": "gwp", "label": "Global warming", "unit": "kg CO₂e", "total": "gwp_total",
        "contributions": {
          "Sodium hydroxide": "lci.naoh.gwp",
          "Sodium phosphate": "lci.na_phosphate.gwp",
          "Process steam": "lci.steam.gwp",
          "Monoammonium phosphate": "lci.map_fertiliser.gwp",
          "Solvent": "lci.solvent.gwp",
          "Ammonium chloride": "lci.nh4cl.gwp",
          "Transport": "lci.transport.gwp",
          "Magnesium sulphate": "lci.mgso4.gwp",
          "Sulfuric acid": "lci.h2so4.gwp",
          "Citric acid": "lci.citric_acid.gwp",
          "Lime": "lci.lime.gwp",
          "Manganese": "lci.manganese.gwp",
          "Chemical (generic)": "lci.chemical_generic.gwp",
          "Calcium chloride": "lci.cacl2.gwp",
          "Water": "lci.water.gwp"
        }
      }
    ],
    "benchmarks": []
  },
  "allocation": {
    "lca": {
      "method": "none",
      "basis": "All inventory burdens are charged to the biocomposite; the biofiller is consumed inside the plant and exported electricity earns no credit in the inventory.",
      "nodes": ["gwp_total"]
    },
    "tea": {
      "method": "system expansion",
      "basis": "Net electricity export is credited at the purchase price on the electricity cost line; no other by-product is sold.",
      "nodes": ["elec_cost", "revenue"]
    }
  },
  "targets": {
    "gwp": { "label": "Climate impact per FU", "nodes": ["gwp_total", "gwp_annual"] },
    "capital": { "label": "Capital cost", "nodes": ["dce", "tci"] },
    "cost": { "label": "Production cost and minimum selling price", "nodes": ["total_cost", "msp"] },
    "profit": { "label": "Profitability", "nodes": ["net_profit", "npv", "project_irr", "payback"] }
  },
  "sensitivity": {
    "tornado_npv": {
      "kind": "oat", "label": "What moves the NPV?",
      "target": "npv", "params": "editable", "delta": 0.1
    },
    "tornado_gwp": {
      "kind": "oat", "label": "What moves the GWP per kg?",
      "target": "gwp_total", "params": "editable", "delta": 0.1
    },
    "price_sweep": {
      "kind": "sweep", "label": "NPV against biocomposite price",
      "target": "npv", "param": "biocomp_p", "from": 2, "to": 12, "steps": 11
    },
    "scale_price_grid": {
      "kind": "sweep", "label": "NPV against plant scale and price",
      "target": "npv",
      "param": "basis_tpa", "from": 2000, "to": 20000, "steps": 7,
      "param2": "biocomp_p", "from2": 3, "to2": 9, "steps2": 5
    },
    "cases": {
      "kind": "scenario", "label": "Feedstock and yield cases",
      "targets": ["gwp_total", "tci", "net_profit", "npv"],
      "scenarios": {
        "double_dry_biomass": { "basis_tpa": 200000 },
        "lignin_rich_feed": { "hemi_pct": 20, "cell_pct": 35, "lign_pct": 40, "ash_pct": 5 },
        "higher_pha_yield": { "rec_pha": 0.45, "biocomp_rec": 95 },
        "wetter_feedstock": { "moisture": 45 }
      }
    },
    "mc_npv": {
      "kind": "montecarlo", "label": "NPV uncertainty",
      "target": "npv", "n": 2000, "seed": 42,
      "params": {
        "biocomp_p": { "dist": "triangular", "min": 4, "mode": 7, "max": 10 },
